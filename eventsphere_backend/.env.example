# =============================================================================
# EventSphere Backend Environment Configuration (.env.example)
# Copy this file to '.env' and fill in your values.
# DO NOT commit '.env' containing real secrets to version control.
# =============================================================================

# --- Server HTTP Port ---
PORT=7080

# =============================================================================
# 1. DATABASE CONFIGURATION
# =============================================================================
# OPTION A: LOCAL DOCKER MYSQL (Default for Local Development / Viva)
DB_URL=jdbc:mysql://localhost:3306/eventsphere_viva_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=mysql

# OPTION B: CLOUD MANAGED MYSQL (e.g. Aiven MySQL)
# Uncomment these 3 lines and comment Option A if switching to Cloud:
# DB_URL=jdbc:mysql://<aiven-host>:15664/defaultdb?createDatabaseIfNotExist=true&sslMode=REQUIRED&enabledTLSProtocols=TLSv1.2,TLSv1.3
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password

# =============================================================================
# 2. SECURITY & AUTHENTICATION
# =============================================================================
JWT_SECRET=LocalSuperSecretKeyForJWTThatIsAtLeast32BytesLong123456!
JWT_EXPIRATION_MS=86400000
TICKET_QR_SECRET=DefaultSuperSecretKeyForSigningEventSphereTickets2026!

# Seeded default admin account (created automatically on first launch)
ADMIN_EMAIL=eventsphere.tickets@gmail.com
ADMIN_PASSWORD=ChangeMe123

# =============================================================================
# 3. CLOUD INTEGRATIONS (SMTP & AI)
# =============================================================================
# Brevo / SendGrid / Gmail SMTP
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_SENDER_EMAIL=eventsphere.tickets@gmail.com

# Google Gemini Generative AI API Key
GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# 4. PAYHERE PAYMENT GATEWAY & WEBHOOKS
# =============================================================================
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=1237371
PAYHERE_MERCHANT_SECRET=your_merchant_secret

# FOR LOCAL RUN:
PAYHERE_RETURN_URL=http://localhost:5500/pages/my-bookings.html
PAYHERE_CANCEL_URL=http://localhost:5500/pages/my-bookings.html
# Update with your active ngrok/localtunnel URL when testing webhooks locally:
PAYHERE_NOTIFY_URL=http://localhost:7080/api/v1/payments/notify

# FOR CLOUD RUN (Render + Vercel):
# PAYHERE_RETURN_URL=https://eventsphere-webapp.vercel.app/pages/my-bookings.html
# PAYHERE_CANCEL_URL=https://eventsphere-webapp.vercel.app/pages/my-bookings.html
# PAYHERE_NOTIFY_URL=https://<your-render-backend-url>/api/v1/payments/notify

# =============================================================================
# 5. CORS ALLOWED ORIGINS
# =============================================================================
# Include local ports (5500, 8000, 3000) and production domains:
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,https://eventsphere-webapp.vercel.app
